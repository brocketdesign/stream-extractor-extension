{
  "manifest_version": 3,
  "name": "Stream Extractor",
  "version": "1.0.0",
  "description": "Detects video streams (HLS, DASH, MP4) on the page you're browsing and opens them in a built-in player tab.",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Stream Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
